{
  "install": {
    "include": [
      "^package\\.json$"
    ],
    "exclude": []
  },
  "restart": {
    "exclude": [
      "^public/",
      "^dist/",
      "^\\.git/",
      "^\\.glitch-assets$",
      "^node_modules/"
    ],
    "include": [
      "\\.js$",
      "\\.json$",
      "^server/"
    ]
  },
  "noSavedEvents": true,
  "throttle": 5000
}
