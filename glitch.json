{
  "install": "npm install",
  "start": "npm start",
  "watch": {
    "ignore": [
      "\\.git",
      "node_modules/**/node_modules"
    ],
    "install": {
      "include": [
        "^package\\.json$"
      ]
    },
    "restart": {
      "include": [
        "^server/"
      ],
      "exclude": [
        "^public/",
        "^node_modules/"
      ]
    },
    "throttle": 5000
  }
}
